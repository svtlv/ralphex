# autopilot repository config: committed, shared by everyone who runs autopilot here.
# Layering: built-in defaults < ~/.config/autopilot/config (AUTOPILOT_CONFIG)
# < this file < AUTOPILOT_TIMEOUTS. Comments must be on their own lines.

[updates]
# check: how often the skills look for newer ralphex.windows and agrouter
# releases on GitHub at their start and offer an upgrade (24h, 1h, 0 = every
# start, off = never)
# check = 24h

[compact]
# mode: at the end of planning, type /compact into the chat before the run
# starts, then wake it to start the run (type), or keep the context (off)
# mode = type

[worktree]
# path: where a new worktree for a run goes (the workspaces layout by default).
#   {parent} the folder that holds this repository, {repo} its name,
#   {branch} the run branch, {Name} the branch with a capital first letter,
#   {summary} the plan title (else {Name})
# path = {parent}/workspaces/{repo}/{summary}
# branch: the run branch name. {type} feature, or bugfix when the plan names a fix,
#   {slug} the plan file name without its date, {summary} the plan title.
#   path knows {type}, {slug} and {summary} too. A branch the user names wins.
# branch = {type}/{slug}
# pr_title: the pull request title. {type}, {summary} the plan title, {slug},
#   {branch}. A title the user names wins.
# pr_title = {summary}

[timeouts]
# Response time per decision: 90s, 10m, 1h, 1h30m or never. After it the
# recommended answer is taken and logged. <key>.remind sets a reminder before it.
# question: planner clarifying question
# question = 10m
# choice: planner multiple choice
# choice = 10m
# yesno: planner yes/no
# yesno = 10m
# draft: plan draft review
# draft = 30m
# draft.remind = 10m
# text: free-text prompt without a safe default
# text = never
# runtime: runner prompt during execution (the run is blocked)
# runtime = 10m
# decide: implement or stop after the plan explanation
# decide = 1h
# decide.remind = 15m
# run_start: start a standalone run
# run_start = 30m
# run_start.remind = 10m
# limit: long rate limit: switch executor or wait
# limit = 30m
# recovery: recovery step that needs a choice
# recovery = 15m
# preflight: preflight choice (worktree, spec override, doc drift, session)
# preflight = 10m
# plan_pick: which plan to run when several exist
# plan_pick = never
# plan_check: redesign a plan the runner cannot run well
# plan_check = 15m
# plan_review: any changes to the finished plan (plan-only flow)
# plan_review = 30m
# review_pick: the runner's plan review: External reviewer, Same agent or Skip review
# review_pick = 10m
# review_apply: which of the runner's plan review findings to apply
# review_apply = 15m
